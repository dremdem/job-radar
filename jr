#!/usr/bin/env bash
# Everyday Job Radar commands, so you do not have to remember them. See README "Everyday commands".
set -euo pipefail

cd "$(dirname "$0")"
HOST=127.0.0.1
PORT=8000
URL="http://$HOST:$PORT"
# The one address at home and away (#66): JOB_RADAR_PUBLIC_URL from the environment or .env.
PUBLIC_URL=${JOB_RADAR_PUBLIC_URL:-$(sed -n 's/^JOB_RADAR_PUBLIC_URL=//p' .env 2>/dev/null | tail -n1 | tr -d "\"'" || true)}
PUBLIC_URL=${PUBLIC_URL%/}
OPEN_URL=${PUBLIC_URL:-$URL}
PID_FILE=data/server.pid
LOG_FILE=data/server.log
ROOT=$(pwd -P)
UNIT=job-radar.service
UNIT_FILE="$HOME/.config/systemd/user/$UNIT"

# With autostart on (a systemd user service), start/stop/restart/status go through systemd.
managed() {
  systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null
}

unit() {
  cat <<UNIT_EOF
[Unit]
Description=Job Radar web UI (docs: README, "Everyday commands")
After=network-online.target

[Service]
WorkingDirectory=$ROOT
Environment=PATH=$PATH
ExecStart=$(command -v uv) run job-radar serve --host $HOST --port $PORT
Restart=on-failure
RestartSec=5
StandardOutput=append:$ROOT/$LOG_FILE
StandardError=append:$ROOT/$LOG_FILE

[Install]
WantedBy=default.target
UNIT_EOF
}

autostart() {
  case "${1:-}" in
    on)
      mkdir -p data "$(dirname "$UNIT_FILE")"
      # A server started by hand would hold the port.
      if ! managed && [[ -n $(server_pid) ]]; then stop; fi
      unit >"$UNIT_FILE"
      systemctl --user daemon-reload
      systemctl --user enable --now "$UNIT"
      if wait_up; then
        echo "Autostart on: $(where) starts with the machine (unit: $UNIT_FILE)"
      else
        echo "The service did not come up; see: systemctl --user status $UNIT" >&2
        return 1
      fi
      if [[ $(loginctl show-user "$USER" -p Linger --value 2>/dev/null) != yes ]]; then
        echo "Note: linger is off, so it starts when you log in, not at boot (loginctl enable-linger)."
      fi
      ;;
    off)
      systemctl --user disable --now "$UNIT" 2>/dev/null || true
      rm -f "$UNIT_FILE"
      systemctl --user daemon-reload
      echo "Autostart off. Start by hand with: ./jr start"
      ;;
    *)
      echo "Usage: ./jr autostart on|off" >&2
      return 2
      ;;
  esac
}

# How to reach the server: the public address first, the local one for this machine only.
where() {
  if [[ -n $PUBLIC_URL ]]; then echo "$PUBLIC_URL (here also $URL)"; else echo "$URL"; fi
}

# tailscale serve: HTTPS on the machine's tailnet name, proxied to the local server.
# Tailnet only (not Funnel); the server itself stays on 127.0.0.1.
tailscale_serve() {
  if [[ ! ${1:-status} =~ ^(on|off|status)$ ]]; then
    echo "Usage: ./jr tailscale on|off|status" >&2
    return 2
  fi
  if ! command -v tailscale >/dev/null; then
    echo "tailscale is not installed: https://tailscale.com/download" >&2
    return 1
  fi
  case "${1:-status}" in
    on)
      if ! tailscale serve --bg --https=443 "$URL"; then
        echo "If it says access denied, allow your user once: sudo tailscale set --operator=\$USER" >&2
        return 1
      fi
      local name
      name=$(tailscale status --json | python3 -c 'import json, sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))')
      echo
      echo "Job Radar over Tailscale: https://$name"
      if [[ $PUBLIC_URL != "https://$name" ]]; then
        echo "Put it in .env so the bookmarklet and ./jr use it, then ./jr restart:"
        echo "  JOB_RADAR_PUBLIC_URL=https://$name"
      fi
      ;;
    off) tailscale serve --https=443 off ;;
    status) tailscale serve status ;;
  esac
}

server_pid() {
  # From the pid file, else any `job-radar serve` started from this folder.
  if [[ -f $PID_FILE ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    cat "$PID_FILE"
  else
    pgrep -f "job-radar serve" | head -n1 || true
  fi
}

wait_up() {
  for _ in $(seq 1 40); do
    curl -sf "$URL/healthz" >/dev/null 2>&1 && return 0
    sleep 0.25
  done
  return 1
}

start() {
  if managed; then
    systemctl --user start "$UNIT" && wait_up && echo "Job Radar is running: $(where) (systemd: $UNIT)"
    return
  fi
  if [[ -n $(server_pid) ]]; then
    echo "Already running: $(where)"
    return 0
  fi
  mkdir -p data
  nohup uv run job-radar serve --host "$HOST" --port "$PORT" >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"
  if wait_up; then
    echo "Job Radar is running: $(where) (log: $LOG_FILE)"
    command -v xdg-open >/dev/null && xdg-open "$OPEN_URL" >/dev/null 2>&1 || true
  else
    echo "The server did not start; last lines of $LOG_FILE:" >&2
    tail -n 20 "$LOG_FILE" >&2
    return 1
  fi
}

stop() {
  if managed; then
    systemctl --user stop "$UNIT" && echo "Stopped (autostart stays on; ./jr autostart off removes it)."
    return
  fi
  local pid
  pid=$(server_pid)
  if [[ -z $pid ]]; then
    echo "Not running."
  else
    pkill -f "job-radar serve" 2>/dev/null || kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do
      [[ -z $(server_pid) ]] && break
      sleep 0.25
    done
    echo "Stopped."
  fi
  rm -f "$PID_FILE"
}

status() {
  if managed; then
    echo "$(systemctl --user is-active "$UNIT"): $(where) (autostart on, systemd: $UNIT)"
    return
  fi
  if [[ -n $(server_pid) ]]; then
    echo "Running: $(where) (pid $(server_pid))"
  else
    echo "Not running. Start it with: ./jr start"
  fi
}

usage() {
  cat <<'EOF'
Usage: ./jr <command>

  start     Start the web UI in the background and open it in the browser
  stop      Stop the web UI
  restart   Restart the web UI (after pulling new code)
  status    Is the web UI running
  logs      Follow the server log
  sync      Sync every source, same as the Sync button
  auth      One-time Gmail consent (read-only)
  update    git pull, install dependencies, restart the web UI
  check     ruff + pytest
  autostart on|off  Start with the machine, restart on crash (systemd user service)
  tailscale on|off|status  One HTTPS address at home and away (tailscale serve)
  unit      Print that service file
  help      This list
EOF
}

case "${1:-help}" in
  start) start ;;
  stop) stop ;;
  restart)
    if managed; then
      systemctl --user restart "$UNIT" && wait_up && echo "Restarted: $(where) (systemd: $UNIT)"
    else
      stop && start
    fi
    ;;
  autostart) autostart "${2:-}" ;;
  tailscale) tailscale_serve "${2:-}" ;;
  unit) unit ;;
  status) status ;;
  logs) touch "$LOG_FILE" && tail -f "$LOG_FILE" ;;
  sync) uv run job-radar sync gmail ;;
  auth) uv run job-radar gmail auth ;;
  update)
    git pull --ff-only
    uv sync
    if managed || [[ -n $(server_pid) ]]; then "$0" restart; else echo "Updated. Start with: ./jr start"; fi
    ;;
  check) uv run ruff check . && uv run ruff format --check . && uv run pytest -q ;;
  help | -h | --help) usage ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
